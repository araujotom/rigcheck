# Absolute origin for canonical links, sitemap.xml and social images.
# Copy this file to `.env.local` and set your production URL before deploying.
# Optional on Netlify: builds fall back to the site's `URL` variable. To override
# it, set this in Site configuration → Environment variables, or with
# `netlify env:set NEXT_PUBLIC_SITE_URL https://your-domain.example`.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
